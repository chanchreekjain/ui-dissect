{
  "manifest_version": 3,
  "name": "UI Dissect",
  "version": "0.1.0",
  "description": "Extract, isolate, and reverse-engineer modern UI aesthetics on hover.",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "UI Dissect"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "toggle-inspect": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle UI Dissect hover inspection mode"
    }
  }
}
